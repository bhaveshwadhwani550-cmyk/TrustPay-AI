# PayPal Sandbox credentials from https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: receiving merchant email, if your sandbox setup requires it
PAYPAL_MERCHANT_EMAIL=

# Local return/cancel destinations
PAYPAL_RETURN_URL=http://localhost:8501/
PAYPAL_CANCEL_URL=http://localhost:8501/

# Optional LLM-based verification. Without this key, the app uses a clearly-labelled
# keyword heuristic demo mode; it does NOT claim that an AI model ran.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
